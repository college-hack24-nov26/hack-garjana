# AutoTwin backend configuration. Copy to .env and adapt to your machine.
APP_ENV=development
APP_NAME=AutoTwin

# SQLite is sufficient for a single-machine engineering tool.
DATABASE_URL=sqlite:///./autotwin_dev.db
STORAGE_ROOT=../storage

# --- External solvers (optional) -------------------------------------------
# Leave blank to use the benchmark-verified in-process scikit-fem solvers,
# which is the default and fully supported path.
# Set CALCULIX_BIN to an absolute path to a ccx executable to register the
# CalculiX adapter alongside them.
CALCULIX_BIN=
ELMER_BIN=
GMSH_BIN=

# --- Optional LLM ----------------------------------------------------------
# The product works fully without this. When set, the assistant may draft
# requirement structures, which are then re-validated against the component
# schemas before anything can be run. Never commit a real key.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Optional Groq model for the AI Insights chat ---------------------------
# Get a key at https://console.groq.com/keys. It stays on this server only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Run limits ------------------------------------------------------------
SOLVER_TIMEOUT_SECONDS=900
MAX_MESH_NODES=400000
MAX_CANDIDATES_PER_RUN=40
JOB_WORKER_THREADS=2
